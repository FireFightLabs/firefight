# Local environment variables
# Copy this file to .env and customize for your local development
#
# Secrets can be provided via ENV vars (this file) or Rails credentials.
# ENV takes precedence — if set, credentials are not checked.

# Slack integration (required)
# Get these from https://api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Force specific Slack workspace for OAuth (optional)
# Find your team ID in Slack URL: https://app.slack.com/client/TXXXXXXXX/...
# Leave blank to allow workspace selection
SLACK_TEAM_ID=

# AI features (optional — leave blank to disable)
ANTHROPIC_API_KEY=

# Where Halon reads code (optional). docker starts one container per run on the
# local Docker daemon, northflank starts a private service per run in a project.
# Left blank, the code tools say code reading is not set up.
SANDBOX_PROVIDER=
# Image the boxes start from. Defaults to ghcr.io/firefightlabs/firefight-sandbox:latest.
# For development, build it with: docker build -t firefight-sandbox:dev sandbox
SANDBOX_IMAGE=
# docker only. The network a box joins, where the app reaches it by name. Leave
# blank when the app runs on the host, and the box is published on 127.0.0.1.
SANDBOX_DOCKER_NETWORK=
# docker only. CPUs and memory per box, 2 and 4g unless set.
SANDBOX_CPUS=
SANDBOX_MEMORY=
# northflank only. Boxes are created in this project, where the app must run too.
NORTHFLANK_API_TOKEN=
NORTHFLANK_SANDBOX_PROJECT=
# northflank only. Plan and ephemeral disk in MB, nf-compute-100-2 and 16384 unless set.
NORTHFLANK_SANDBOX_PLAN=
NORTHFLANK_SANDBOX_STORAGE=

# Set to true to require an invite code for new workspace installs. Off by
# default. Codes are created in the Rails console.
INVITE_REQUIRED=

# JSON POST sent here on every new workspace install. A Slack incoming
# webhook URL works. Leave blank to send nothing.
INSTALL_NOTIFICATION_WEBHOOK_URL=

# Dashboard host for the links Firefight posts to Slack (incident homepage,
# postmortem). Without it those buttons are not shown. In development use
# your tunnel host, e.g. abc123.ngrok.io
APP_HOST=
APP_PROTOCOL=https

# Allowed hosts for development (comma-separated)
# Add your tunnelmole/ngrok URL here to allow Slack webhooks
# Example: ALLOWED_HOSTS=abc123.ngrok.io,xyz789.tunnelmole.net
ALLOWED_HOSTS=

# Active Record encryption (required)
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Active Storage service (local, test, r2)
ACTIVE_STORAGE_SERVICE=local

# Cloudflare R2 settings
# Example endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_REQUEST_CHECKSUM_CALCULATION=when_required
R2_RESPONSE_CHECKSUM_VALIDATION=when_required

# Integration OAuth apps (optional, per provider that needs a pre-registered
# app, e.g. GitHub which has no dynamic client registration). One Firefight
# app per provider serves every workspace and tokens are stored per-workspace.
# GitHub: register a GitHub App (Settings -> Developer settings -> GitHub Apps),
# enable "Request user authorization (OAuth) during installation", and set the
# callback URL to https://<your-host>/app/integrations/oauth/callback.
# In production these come from Infisical, injected as env vars.
# INTEGRATION_GITHUB_CLIENT_ID=
# INTEGRATION_GITHUB_CLIENT_SECRET=
# The app slug from its GitHub URL (github.com/apps/<slug>). Set for apps that
# must be installed before their tokens reach anything: connecting then starts
# at the install screen, so customers never visit GitHub to install by hand.
# INTEGRATION_GITHUB_APP_SLUG=
#
# Later, for autonomous agent writes that should act as Firefight itself
# (a GitHub App bot identity) rather than as the authorizing user. Requires
# GitHub to ship installation-token support on their MCP server, or a
# first-party GitHub pack calling the REST API directly.
# INTEGRATION_GITHUB_APP_ID=
# INTEGRATION_GITHUB_PRIVATE_KEY=

# Private database hosts the PostgreSQL connection may reach, comma separated
# names, addresses or ranges. Left blank, only public addresses are reached,
# since the connection is made from Firefight's own network. Set it to reach a
# database next to Firefight, such as its own or a self-hosted one.
# INTEGRATION_POSTGRESQL_PRIVATE_HOSTS=10.0.0.0/8,db.internal

# The operator console at /operator, for the people who run this Firefight rather
# than a workspace: the jobs dashboard now, workflows, incidents and Halon next.
# Comma separated user ids. Anyone else, signed in or not, gets not found there.
# Each operator also sets up an authenticator app on their first visit.
# OPERATOR_USER_IDS=
