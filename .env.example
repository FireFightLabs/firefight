# Local environment variables
# Copy this file to .env and customize for your local development
#
# Secrets can be provided via ENV vars (this file) or Rails credentials.
# ENV takes precedence — if set, credentials are not checked.

# Slack integration (required)
# Get these from https://api.slack.com/apps → your app → Basic Information
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Force specific Slack workspace for OAuth (optional)
# Find your team ID in Slack URL: https://app.slack.com/client/TXXXXXXXX/...
# Leave blank to allow workspace selection
SLACK_TEAM_ID=

# AI features (optional — leave blank to disable)
ANTHROPIC_API_KEY=
# Halon's models (optional). Investigations and chats share INVESTIGATION_AI_MODEL, the
# strongest model. The citation re-check, one call with no tools, can run on a small model
# and uses the investigation's model until given its own. LESSONS_AI_MODEL, for reading what
# an ended incident taught, falls back to the citation re-check's model. Postmortems use the
# investigation's model too unless POSTMORTEM_AI_MODEL is set. Add _PROVIDER (for example openrouter) for a model the registry cannot place.
INVESTIGATION_AI_MODEL=
CITATION_CHECK_AI_MODEL=
LESSONS_AI_MODEL=
# The model code fixes write with on a workspace's own AI account, per provider, in that
# provider's own name for it. Unset uses config/ai_providers.yml. CODE_FIX_AI_MODEL above
# covers this deployment's own keys.
ANTHROPIC_CODE_FIX_MODEL=
OPENROUTER_CODE_FIX_MODEL=
OPENAI_CODE_FIX_MODEL=

# Where Halon reads code (optional). docker starts one container per run on the
# local Docker daemon, northflank starts a private service per run in a project,
# boat starts a boat.dev sandbox (a VM in the EU) per run.
# Left blank, the code tools say code reading is not set up.
SANDBOX_PROVIDER=
# Optional backup, one of the same. A box the main provider cannot start (no
# capacity, an outage, a timeout, a refusal) starts here instead, and the operator
# console shows the failover. A workspace held to one provider never fails over.
SANDBOX_BACKUP_PROVIDER=
# Image the boxes start from. Defaults to ghcr.io/firefightlabs/firefight-sandbox at
# the app's release version, or its edge build when the app image is not a release.
# For development, build it with: docker build -t firefight-sandbox:dev sandbox
SANDBOX_IMAGE=
# docker only. The network a box joins, where the app reaches it by name. Leave
# blank when the app runs on the host, and the box is published on 127.0.0.1.
SANDBOX_DOCKER_NETWORK=
# docker only. CPUs and memory per box, 2 and 4g unless set.
SANDBOX_CPUS=
SANDBOX_MEMORY=
# northflank only. Boxes are created in this project. The app must run on Northflank
# too, in this project or in another one this project allows ingress from (same team
# and cluster). Give the boxes' project no secret groups. See SELF_HOSTING.md.
NORTHFLANK_API_TOKEN=
NORTHFLANK_SANDBOX_PROJECT=
# northflank only. Plan and ephemeral disk in MB, nf-compute-100-2 and 16384 unless set.
NORTHFLANK_SANDBOX_PLAN=
NORTHFLANK_SANDBOX_STORAGE=
# boat only. An API key with sandbox.create, sandbox.read, sandbox.update,
# sandbox.stop, sandbox.delete, exec, host, snapshot.read and snapshot.write.
BOAT_API_KEY=
# boat only. Machine size, small, default, large or xlarge, default unless set.
BOAT_SANDBOX_TYPE=
# boat only. The organization wallet boxes bill, by id or name. Blank bills the
# key's active wallet.
BOAT_ORG=

# Outgoing mail, for email sign-in links and sign-in notices. Without
# SMTP_ADDRESS, MAIL_FROM and APP_HOST a deployed Firefight sends no mail and
# hides email sign-in. In development, mail opens in the browser unless
# SMTP_ADDRESS is set. SMTP_PORT is 587 unless set.
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender, for example: Firefight <no-reply@example.com>
MAIL_FROM=

# Sign in with Google (optional). Create an OAuth client of type Web
# application in Google Cloud, with the redirect URI
# https://<your-host>/auth/google_oauth2/callback. Google and email sign-in
# also wait for the self_serve_signup flag:
# bin/rails 'feature_flags:enable_globally[self_serve_signup]'
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set to true to require an invite code to create a workspace, however the
# person signed in. Off by default. Codes are created in the Rails console.
INVITE_REQUIRED=

# JSON POST sent here when a workspace is created, when one connects Slack
# later, and when one of this install's own AI keys is refused for credit or
# runs low. A Slack incoming webhook URL works. Leave blank to send nothing.
INSTALL_NOTIFICATION_WEBHOOK_URL=

# Alert on the webhook above when an AI key of this install's own has less
# than this many dollars left to spend, checked hourly where the provider says
# (OpenRouter keys with a spending limit). Defaults to 10.
FIREFIGHT_AI_LOW_BALANCE_USD=10

# A Slack user id (such as U012AB3CD) tagged in each AI key alert. Optional.
FIREFIGHT_AI_ALERT_SLACK_USER_ID=

# Dashboard host for the links Firefight posts to Slack (incident homepage,
# postmortem). Without it those buttons are not shown. In development use
# your tunnel host, e.g. abc123.ngrok.io
APP_HOST=
APP_PROTOCOL=https

# Faylee bug reports (optional, off by default). Set both values to enable the widget.
FAYLEE_VERIFICATION_TOKEN=
FAYLEE_SITE_ID=

# Allowed hosts for development (comma-separated)
# Add your tunnelmole/ngrok URL here to allow Slack webhooks
# Example: ALLOWED_HOSTS=abc123.ngrok.io,xyz789.tunnelmole.net
ALLOWED_HOSTS=

# Active Record encryption (required)
# Generate with: bin/rails db:encryption:init
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Active Storage service (local, test, r2)
ACTIVE_STORAGE_SERVICE=local

# Cloudflare R2 settings
# Example endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_REGION=auto
R2_REQUEST_CHECKSUM_CALCULATION=when_required
R2_RESPONSE_CHECKSUM_VALIDATION=when_required

# Integration OAuth apps (optional, per provider that needs a pre-registered
# app, e.g. GitHub which has no dynamic client registration). One Firefight
# app per provider serves every workspace and tokens are stored per-workspace.
# GitHub: register a GitHub App (Settings -> Developer settings -> GitHub Apps),
# enable "Request user authorization (OAuth) during installation", and set the
# callback URL to https://<your-host>/app/integrations/oauth/callback.
# In production these come from Infisical, injected as env vars.
# INTEGRATION_GITHUB_CLIENT_ID=
# INTEGRATION_GITHUB_CLIENT_SECRET=
# The app slug from its GitHub URL (github.com/apps/<slug>). Set for apps that
# must be installed before their tokens reach anything: connecting then starts
# at the install screen, so customers never visit GitHub to install by hand.
# INTEGRATION_GITHUB_APP_SLUG=
# The secret the App signs its webhook deliveries with, the same value as its
# Webhook secret setting. With its Webhook URL set to
# https://<your-host>/api/v1/app_events/github and the Push and Repository
# events chosen, repository changes reach the resource map within a minute.
# INTEGRATION_GITHUB_WEBHOOK_SECRET=
#
# Later, for autonomous agent writes that should act as Firefight itself
# (a GitHub App bot identity) rather than as the authorizing user. Requires
# GitHub to ship installation-token support on their MCP server, or a
# first-party GitHub pack calling the REST API directly.
# INTEGRATION_GITHUB_APP_ID=
# INTEGRATION_GITHUB_PRIVATE_KEY=

# Firefight's own apps for keeping incident items in step with issues, which
# connect Linear and Jira natively and register the webhook that sends changes
# back. Without them, a workspace connects through each provider's MCP server
# and sets the webhook up by hand. The callback URL for both is
# https://<your-host>/app/integrations/oauth/callback.
# Linear: create an OAuth application (Settings -> API -> OAuth applications)
# with that callback URL. It asks for the read, write and admin scopes.
# INTEGRATION_LINEAR_APP_CLIENT_ID=
# INTEGRATION_LINEAR_APP_CLIENT_SECRET=
# Jira: create an OAuth 2.0 integration at developer.atlassian.com/console/myapps
# with that callback URL, and add the Jira API scopes read:jira-work,
# write:jira-work, read:jira-user and manage:jira-webhook. Atlassian signs the
# webhooks it registers with this secret.
# INTEGRATION_JIRA_APP_CLIENT_ID=
# INTEGRATION_JIRA_APP_CLIENT_SECRET=

# Private database hosts the PostgreSQL connection may reach, comma separated
# names, addresses or ranges. Left blank, only public addresses are reached,
# since the connection is made from Firefight's own network. Set it to reach a
# database next to Firefight, such as its own or a self-hosted one.
# INTEGRATION_POSTGRESQL_PRIVATE_HOSTS=10.0.0.0/8,db.internal

# Private Kubernetes API servers the Kubernetes connection may reach, comma
# separated names, addresses or ranges. Left blank, only public addresses are
# reached, for the same reason. Set it to reach a cluster next to Firefight.
# INTEGRATION_KUBERNETES_PRIVATE_HOSTS=10.0.0.0/8,cluster.internal

# Private hosts a GitLab connection may reach, comma separated names, addresses or
# ranges. Left blank, a self-managed GitLab is reached only on a public address.
# Set it to reach a GitLab inside the same network as Firefight.
# INTEGRATION_GITLAB_PRIVATE_HOSTS=gitlab.internal,10.0.0.0/8

# The operator console at /operator, for the people who run this Firefight rather
# than a workspace: the overview, incidents, workflows, jobs and Halon.
# Comma separated user ids. Anyone else, signed in or not, gets not found there.
# Each operator also sets up an authenticator app on their first visit.
# OPERATOR_USER_IDS=
