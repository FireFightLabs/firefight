# Settings for docker-compose.yml. Copy to .env next to it and fill in. See SELF_HOSTING.md.

# The hostname Firefight answers on, such as firefight.example.com. Point its DNS at this machine first.
FIREFIGHT_HOST=

# The bundled Postgres. Choose any password.
POSTGRES_USER=firefight
POSTGRES_PASSWORD=

# docker run --rm ghcr.io/firefightlabs/firefight:latest bin/rails secret
SECRET_KEY_BASE=

# docker run --rm ghcr.io/firefightlabs/firefight:latest bin/rails db:encryption:init
# Keep these safe. Encrypted data cannot be read without them.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# From your Slack app's Basic Information page.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional. Locks sign-in to one Slack workspace.
SLACK_TEAM_ID=

# Optional. Leave empty and each workspace adds its own AI account under Settings, Workspace.
ANTHROPIC_API_KEY=

# Optional. Report errors to your own Sentry project.
SENTRY_DSN=
SENTRY_FRONTEND_DSN=

# Only when Halon reads code in Docker boxes on this machine. The group that owns the Docker socket:
# stat -c %g /var/run/docker.sock
DOCKER_GID=
