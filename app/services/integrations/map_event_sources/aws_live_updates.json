{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sends changes to the ECS services, Lambda functions, EC2 instances, RDS databases, CodeBuild projects, pipelines, deployments, stacks, App Runner services and Elastic Beanstalk environments in this region to one Firefight connection, so its resource map follows them as they happen. Delete this stack to stop.",
  "Parameters": {
    "Address": {
      "Type": "String",
      "Description": "The connection's own address in Firefight, where changes are sent.",
      "AllowedPattern": "https://.+"
    },
    "Key": {
      "Type": "String",
      "Description": "The key Firefight made for this connection. Firefight accepts a change only when it carries this key.",
      "MinLength": 32
    }
  },
  "Resources": {
    "FirefightConnection": {
      "Type": "AWS::Events::Connection",
      "Properties": {
        "Description": "Firefight live updates",
        "AuthorizationType": "API_KEY",
        "AuthParameters": {
          "ApiKeyAuthParameters": {
            "ApiKeyName": "x-firefight-key",
            "ApiKeyValue": { "Ref": "Key" }
          }
        }
      }
    },
    "FirefightDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Properties": {
        "Description": "Firefight live updates",
        "ConnectionArn": { "Fn::GetAtt": [ "FirefightConnection", "Arn" ] },
        "HttpMethod": "POST",
        "InvocationEndpoint": { "Ref": "Address" },
        "InvocationRateLimitPerSecond": 10
      }
    },
    "FirefightRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            { "Effect": "Allow", "Principal": { "Service": [ "events.amazonaws.com" ] }, "Action": [ "sts:AssumeRole" ] }
          ]
        },
        "Policies": [
          {
            "PolicyName": "firefight-live-updates",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                { "Effect": "Allow", "Action": [ "events:InvokeApiDestination" ], "Resource": { "Fn::GetAtt": [ "FirefightDestination", "ArnForPolicy" ] } }
              ]
            }
          }
        ]
      }
    },
    "FirefightStateChanges": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "State changes of EC2 instances, ECS services, RDS databases and CodeBuild builds, sent to Firefight",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.ec2", "aws.ecs", "aws.rds", "aws.codebuild" ],
          "detail-type": [
            "EC2 Instance State-change Notification", "ECS Service Action", "ECS Deployment State Change", "RDS DB Instance Event",
            "CodeBuild Build State Change", "CodeBuild Build Phase Change"
          ]
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    },
    "FirefightApiCalls": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Changes made to EC2 instances, ECS services, Lambda functions, RDS databases and CodeBuild projects through their APIs, sent to Firefight",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.ec2", "aws.ecs", "aws.lambda", "aws.rds", "aws.codebuild" ],
          "detail-type": [ "AWS API Call via CloudTrail" ],
          "detail": {
            "eventSource": [ "ec2.amazonaws.com", "ecs.amazonaws.com", "lambda.amazonaws.com", "rds.amazonaws.com", "codebuild.amazonaws.com" ],
            "eventName": [
              "RunInstances", "StartInstances", "StopInstances", "TerminateInstances", "ModifyInstanceAttribute", "CreateTags", "DeleteTags",
              "CreateService", "UpdateService", "DeleteService", "TagResource", "UntagResource",
              { "prefix": "CreateFunction" }, { "prefix": "UpdateFunctionCode" }, { "prefix": "UpdateFunctionConfiguration" },
              { "prefix": "PublishVersion" }, { "prefix": "UpdateAlias" },
              { "prefix": "DeleteFunction" }, { "prefix": "TagResource" }, { "prefix": "UntagResource" },
              "CreateDBInstance", "CreateDBInstanceReadReplica", "RestoreDBInstanceFromDBSnapshot", "RestoreDBInstanceToPointInTime",
              "ModifyDBInstance", "RebootDBInstance", "StartDBInstance", "StopDBInstance", "PromoteReadReplica", "DeleteDBInstance",
              "AddTagsToResource", "RemoveTagsFromResource",
              "CreateProject", "UpdateProject", "DeleteProject"
            ]
          }
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    },
    "FirefightReleaseChanges": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Pipeline executions, CodeDeploy deployments, App Runner services and Elastic Beanstalk environments changing state, sent to Firefight",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.codepipeline", "aws.codedeploy", "aws.apprunner", "aws.elasticbeanstalk" ],
          "detail-type": [
            "CodePipeline Pipeline Execution State Change", "CodePipeline Stage Execution State Change", "CodePipeline Action Execution State Change",
            "CodeDeploy Deployment State-change Notification", "AppRunner Service Operation Status Change", "AppRunner Service Status Change",
            "Elastic Beanstalk resource status change", "Health status change"
          ]
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    },
    "FirefightStackChanges": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "The account's other CloudFormation stacks changing status, sent to Firefight",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.cloudformation" ],
          "detail-type": [ "CloudFormation Stack Status Change" ],
          "detail": { "stack-id": [ { "anything-but": [ { "Ref": "AWS::StackId" } ] } ] }
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    },
    "FirefightReleaseApiCalls": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "Releases started, stopped or rolled back, and pipelines, deployment groups, stacks, App Runner services and Elastic Beanstalk environments made, changed or removed through their APIs, sent to Firefight",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.codepipeline", "aws.codedeploy", "aws.cloudformation", "aws.apprunner", "aws.elasticbeanstalk" ],
          "detail-type": [ "AWS API Call via CloudTrail" ],
          "detail": {
            "eventSource": [
              "codepipeline.amazonaws.com", "codedeploy.amazonaws.com", "cloudformation.amazonaws.com", "apprunner.amazonaws.com",
              "elasticbeanstalk.amazonaws.com"
            ],
            "eventName": [
              "CreatePipeline", "UpdatePipeline", "DeletePipeline", "StartPipelineExecution", "StopPipelineExecution", "RollbackStage", "RetryStageExecution",
              "CreateDeployment", "CreateDeploymentGroup", "UpdateDeploymentGroup", "DeleteDeploymentGroup",
              "CreateStack", "UpdateStack", "DeleteStack", "CancelUpdateStack", "ExecuteChangeSet", "ContinueUpdateRollback",
              "CreateService", "UpdateService", "DeleteService", "StartDeployment", "PauseService", "ResumeService",
              "CreateEnvironment", "UpdateEnvironment", "TerminateEnvironment", "RestartAppServer", "RebuildEnvironment"
            ]
          }
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    },
    "FirefightStackStatus": {
      "Type": "AWS::Events::Rule",
      "Properties": {
        "Description": "This stack being created or deleted, so Firefight knows whether this region sends it changes",
        "State": "ENABLED",
        "EventPattern": {
          "source": [ "aws.cloudformation" ],
          "detail-type": [ "CloudFormation Stack Status Change" ],
          "detail": { "stack-id": [ { "Ref": "AWS::StackId" } ] }
        },
        "Targets": [
          { "Id": "firefight", "Arn": { "Fn::GetAtt": [ "FirefightDestination", "Arn" ] }, "RoleArn": { "Fn::GetAtt": [ "FirefightRole", "Arn" ] } }
        ]
      }
    }
  }
}
