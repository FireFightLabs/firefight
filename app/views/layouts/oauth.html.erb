<!DOCTYPE html>
<html>
  <head>
    <title>Connect an agent · Firefight</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <link rel="icon" href="/firefight-favicon.svg" type="image/svg+xml">
    <style>
      :root { color-scheme: dark; }
      body { margin: 0; min-height: 100vh; display: grid; place-items: center;
             background: #0b121c; color: #e6ecf4;
             font-family: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif; }
      .card { width: min(420px, calc(100vw - 48px)); background: #111b29;
              border: 1px solid #223145; border-radius: 12px; padding: 28px; }
      h1 { font-size: 19px; margin: 0 0 6px; }
      p { margin: 8px 0; font-size: 14px; line-height: 1.5; color: #9daabc; }
      .who { color: #e6ecf4; }
      ul { margin: 10px 0; padding-left: 18px; font-size: 14px; color: #9daabc; }
      .actions { display: flex; gap: 10px; margin-top: 20px; }
      .actions form { flex: 1; }
      button { width: 100%; padding: 10px 0; border-radius: 8px; border: 1px solid transparent;
               font-size: 14px; font-weight: 600; cursor: pointer; }
      .authorize { background: #38d3e3; color: #08222a; }
      .deny { background: transparent; color: #9daabc; border-color: #223145; }
      .error { color: #ff8080; }
    </style>
  </head>
  <body>
    <div class="card"><%= yield %></div>
  </body>
</html>
