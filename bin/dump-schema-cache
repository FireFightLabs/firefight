#!/bin/bash -e

# Writes db/schema_cache.yml and db/<database>_schema_cache.yml for every database in config/database.yml, run by the
# Dockerfile so a process boots knowing each table's columns instead of reading them from the database on its first
# requests. They are read from the schema files in this checkout, loaded into a Postgres that lives only for this
# script, so the cache is always that of the code shipped beside it. Rails checks each file's version against the
# database it connects to and ignores one that differs, so a cache built before a migration ran is never used.
#
# Needs the Postgres server and pgvector packages, and runs as root, as in the Dockerfile's build stage.

version=17
port=5499
data="$(mktemp -d)"
chown postgres "$data"
pg() { su postgres -s /bin/bash -c "/usr/lib/postgresql/$version/bin/$*"; }

pg "initdb -D $data -A trust -U postgres" > /dev/null
pg "pg_ctl -D $data -o '-c listen_addresses=127.0.0.1 -p $port' -w start" > /dev/null
trap 'pg "pg_ctl -D $data -m fast -w stop" > /dev/null; rm -rf "$data"' EXIT

# Production boots as it is deployed, with placeholders for what only a running app needs.
export RAILS_ENV=production DISABLE_DATABASE_ENVIRONMENT_CHECK=1 SECRET_KEY_BASE_DUMMY=1 CONNECTION_WARMUP=false \
  ALLOWED_HOSTS=schema-cache.invalid SLACK_SIGNING_SECRET=schema-cache SLACK_CLIENT_ID=schema-cache SLACK_CLIENT_SECRET=schema-cache \
  FIREFIGHT_DATABASE_HOST=127.0.0.1 FIREFIGHT_DATABASE_PORT=$port FIREFIGHT_DATABASE_SSLMODE=disable \
  FIREFIGHT_DATABASE_USERNAME=postgres FIREFIGHT_DATABASE_PASSWORD="" \
  FIREFIGHT_DATABASE=firefight FIREFIGHT_DATABASE_CACHE=firefight_cache FIREFIGHT_DATABASE_QUEUE=firefight_queue \
  FIREFIGHT_DATABASE_CABLE=firefight_cable

./bin/rails db:create db:schema:load db:schema:cache:dump
