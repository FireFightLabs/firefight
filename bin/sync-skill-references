#!/usr/bin/env ruby
# Copies each provider's guides listed in config/skill_references.yml into config/skills/<provider>/references/,
# replacing what is there, with the license they come under and where they came from. Naming providers
# (bin/sync-skill-references aws kubernetes) copies only theirs. Run by hand or by the daily workflow, which opens a pull
# request when anything changed.
#
# A provider is one of two kinds of source.
#
# A git repository:
#   repository  the address to clone
#   license     the license file's path, copied as LICENSE
#   notice      the NOTICE file's path, copied as NOTICE, for a license that asks for it to travel with a copy (optional)
#   paths       from => to. A folder copies each guide in it into to/, and a file copies to the path to names
#   extensions  the guides' extensions in folders, md unless it says (such as [md, mdx]). Each is kept as .md
#   exclude     paths in the repository to leave out (optional)
#
# A documentation site whose pages are served as markdown:
#   site        the site's address
#   license     the license, in words, written as LICENSE
#   pages       path => page, each fetched at page_url
#   page_url    where a page's markdown is, as a format of site and page, %<site>s/%<page>s/index.md unless it says
#
# A path or page that is gone fails the run, so a moved guide is noticed.
require "yaml"
require "fileutils"
require "tmpdir"
require "net/http"
require "uri"

root = File.expand_path("..", __dir__)
sources = YAML.safe_load_file(File.join(root, "config/skill_references.yml"))
unknown = ARGV - sources.keys
abort "No guides are listed for #{unknown.join(', ')}" if unknown.any?
sources = sources.slice(*ARGV) if ARGV.any?

DEFAULT_PAGE_URL = "%<site>s/%<page>s/index.md".freeze

def fetch(url, redirects = 3)
  response = Net::HTTP.get_response(URI(url))
  return fetch(response["location"], redirects - 1) if response.is_a?(Net::HTTPRedirection) && redirects.positive?
  raise "#{url} answered #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  response.body.force_encoding(Encoding::UTF_8)
end

# A guide is read as markdown, so it is kept as .md whatever extension its repository gives it.
def as_markdown(name) = name.sub(/\.[a-z]+\z/, ".md")

def copy_repository(source, checkout, staged)
  left_out = source.fetch("exclude", []).map { |path| File.join(checkout, path) }
  extensions = Array(source.fetch("extensions", [ "md" ]))
  source.fetch("paths").each do |from, to|
    path = File.join(checkout, from)
    if File.file?(path)
      FileUtils.mkdir_p(File.dirname(File.join(staged, to)))
      FileUtils.cp(path, File.join(staged, to))
    elsif File.directory?(path)
      (Dir[File.join(path, "*.{#{extensions.join(',')}}")] - left_out).each do |file|
        FileUtils.mkdir_p(File.join(staged, to))
        FileUtils.cp(file, File.join(staged, to, as_markdown(File.basename(file))))
      end
    else
      raise "#{source.fetch('repository')} has no #{from}"
    end
  end
  FileUtils.cp(File.join(checkout, source.fetch("license")), File.join(staged, "LICENSE"))
  FileUtils.cp(File.join(checkout, source.fetch("notice")), File.join(staged, "NOTICE")) if source["notice"]
end

sources.each do |provider, source|
  target = File.join(root, "config/skills", provider, "references")
  Dir.mktmpdir do |dir|
    staged = File.join(dir, "references")
    FileUtils.mkdir_p(staged)

    if source["repository"]
      checkout = File.join(dir, "checkout")
      system("git", "clone", "--quiet", "--depth", "1", source.fetch("repository"), checkout, exception: true)
      commit = `git -C #{checkout} rev-parse HEAD`.strip
      copy_repository(source, checkout, staged)
      File.write(File.join(staged, "SOURCE"), "#{source.fetch('repository')}\n#{commit}\n")
      puts "#{provider}: #{source.fetch('repository')} at #{commit}"
    else
      urls = source.fetch("pages").map do |path, page|
        url = format(source.fetch("page_url", DEFAULT_PAGE_URL), site: source.fetch("site"), page: page)
        FileUtils.mkdir_p(File.dirname(File.join(staged, path)))
        File.write(File.join(staged, path), fetch(url))
        "#{path} #{url}"
      end
      File.write(File.join(staged, "LICENSE"), source.fetch("license"))
      File.write(File.join(staged, "SOURCE"), "#{urls.join("\n")}\n")
      puts "#{provider}: #{urls.size} pages from #{source.fetch('site')}"
    end

    FileUtils.rm_rf(target)
    FileUtils.mkdir_p(File.dirname(target))
    FileUtils.mv(staged, target)
  end
end
